# Copier vers config.env. Ce fichier est lu comme un script Bash : administrateur uniquement.
DATA_DIR=/srv/bibliotech
WIFI_INTERFACE=wlan0
WIFI_SSID=BiblioTech
# 8 à 63 caractères ASCII. Obligatoire, aucun mot de passe public par défaut.
WIFI_PASSWORD=''
WIFI_COUNTRY=FR
WIFI_CHANNEL=6
# Le réseau local utilise 10.42.0.1/24. Éviter ce sous-réseau sur la connexion amont.
# La carte doit être préparée sur un ordinateur et copiée dans :
# /srv/bibliotech/maps/europe.pmtiles
